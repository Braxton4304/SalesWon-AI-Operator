# POC Runtime Configuration
APP_ENV=local
TENANT_ID=dev-tenant

# LLM Provider: azure_openai | rule_based (fallback when Azure creds missing)
LLM_PROVIDER=azure_openai

# Azure OpenAI (required when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Connector: servicenow
CONNECTOR=servicenow

# ServiceNow (required when connector is active)
SERVICENOW_INSTANCE_URL=
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD_OR_TOKEN=

# Audit log path (JSONL)
AUDIT_LOG_PATH=./audit/events.jsonl

# Runtime config (repo root relative from backend cwd)
RUNTIME_CONFIG_PATH=../../../runtime/CONFIG.yaml
